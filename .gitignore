__pycache__/
data/
TF Outputs/
hpc scripts/
logs/
comparison_results/

# ---------------------------------------------------------------------------
# Run outputs. Code is versioned; results are not -- they are large, they are
# regenerable, and they are per-machine.
#
# The 2026-07 folder reorganisation moved every sweep output under
# Results_of_Sweeps/, which silently defeated the path-anchored rules below
# (they only ever matched the OLD locations). That exposed ~114 MB of run
# artifacts, including 168 model.pt files, to git. The Results_of_Sweeps rule is
# what actually does the work now; the old paths are kept so anything restored
# to its former location stays ignored too.
# ---------------------------------------------------------------------------
VAE_Stability_Testing/Results_of_Sweeps/

VAE_Stability_Testing/epoch_sweep/
VAE_Stability_Testing/seed_comparison/
VAE_Stability_Testing/seed_density_sweep/
VAE_Stability_Testing/seed_sweep_extended/
VAE_Stability_Testing/sweep_results/
VAE_Stability_Testing/sweep_results_1M/
VAE_Stability_Testing/sweep_results_10M/
VAE_Stability_Testing/sweep_results_c1/
VAE_Stability_Testing/sweep_results_full/
VAE_Stability_Testing/sweep_seed_results/
VAE_Stability_Testing/vs_52M_comparison/
VAE_Stability_Testing/rq_sweep/

# End-to-end pipeline runs. These are far too big for GitHub -- the 20260709
# run alone holds a 111.9 MB parquet and a 110.0 MB umap pickle, both over
# GitHub's hard 100 MB per-file limit, so a push containing them is rejected.
train_then_cluster_*/
clust_regime_sweep/*.log
clust_regime_sweep/*.err

# Sweep and run roots the tmux runners create (see TMUX_RUNNERS.md).
sweeps/
runs/
uv_vae/sweeps/
uv_vae/runs/

# ---------------------------------------------------------------------------
# Data inputs and binary artifacts. These had NO rule until 2026-07-29, and
# parquet_files/ (11.7 GB in two featuremaps) was merely *untracked* -- which is
# not the same as ignored. A single `git add -A` from the repo root was enough to
# write multi-GB blobs into .git/objects, and unstaging does not remove them:
# 3.1 GB of dangling parquet blobs had to be pruned to reclaim the space.
#
# Note that ignoring only stops future wildcard adds. It does not protect
# .git/objects from `git add -f`, and it never removes blobs already written.
# ---------------------------------------------------------------------------
parquet_files/
*.parquet
*.tar

# Model checkpoints and encoded caches -- regenerable, and large enough to blow
# past GitHub's 100 MB per-file limit.
*.pt
*.npy

# ---------------------------------------------------------------------------
# cohort_cluster_report.py output. Each cell writes one UMAP panel per colour
# column plus one SBS96 profile PNG per cluster -- at 88-1,330 clusters a cell
# that is 6.28 GB across 16,310 PNG files for the 28-cell grid. Nothing above
# covered PNGs, so this was the one remaining path where a wildcard add from the
# repo root would still have written multi-GB blobs into .git/objects.
#
# The report.json / summary.csv / index_all_cells.json are NOT ignored -- they
# are the numbers, they are small, and they are what the plots are read beside.
# cluster_profiles_manifest.json is 23 MB of PNG filenames and is regenerable.
# ---------------------------------------------------------------------------
**/cohort_reports*/**/plots/
**/cohort_reports*/**/cluster_profiles/
**/cohort_reports*/**/cluster_profiles_manifest.json
**/cohort_reports*/**/feature_atlas/
**/cohort_reports*/**/feature_atlas_enriched/
**/cohort_reports*/**/feature_distributions/
**/cohort_reports*/**/*.parquet
**/cohort_reports*/**/plot_sample.parquet
**/results/cluster_plots/
**/results/cluster_sweep_plots/
**/results/feature_atlas*/

# Trained model binaries. hdbscan_model.pkl is 171 MB -- over GitHub's 100 MB
# hard limit, so committing it does not merely bloat the repo, it makes the push
# fail. The .npy/.parquet rules above already cover the coordinate arrays; this
# covers the pickles beside them. Models are distributed with the deployment
# folder, not through git.
*.pkl

# ---------------------------------------------------------------------------
# Sweep outputs, cluster results, and large binary artifacts added 2026-09-03.
# These accumulate under umap_hdbscan_sweep/ and hdbscan_sweep/ and are too
# large / regenerable to version.
# ---------------------------------------------------------------------------

# Full sweep trees
umap_hdbscan_sweep/
hdbscan_sweep/images/
hdbscan_sweep.zip
per_parquet_reports.tar.gz
plots/

# Session / agent context dumps (not project artefacts)
AGENT_CONTEXT_*.md
SESSION_SUMMARY_*.md

# Binary / office documents
*.docx
*.xlsx
*.zip
*.tar.gz

# Log and error files from SLURM/tmux jobs
*.err
*.log
